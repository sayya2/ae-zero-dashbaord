# ── Database ──────────────────────────────────────────────────────────
# Docker dev: mysql://ae_admin:ae_dashboard_pass@localhost:3307/ae_dashboard
# Hostinger prod: mysql://user:pass@host:3306/dbname
DATABASE_URL=mysql://ae_admin:ae_dashboard_pass@localhost:3307/ae_dashboard

# ── NextAuth ──────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-32-char-random-string
NEXTAUTH_URL=http://localhost:3001

# ── First Admin Seed (disable after setup) ───────────────────────────
DASHBOARD_SEED_KEY=replace-with-secure-one-time-key

# ── AWS S3 (same bucket as the website) ──────────────────────────────
